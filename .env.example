# --- Zoraxy (Pflicht) ---
ZORAXY_URL=http://192.168.60.199:8000
ZORAXY_USER=admin
ZORAXY_PASS=changeme
# ZORAXY_INSECURE=true          # Admin-UI per https mit selbstsigniertem Zertifikat

# --- Proxmox (optional) ---
# Token anlegen: Datacenter → Permissions → API Tokens, Rolle PVEAuditor auf "/"
# Für VM-IPs (Guest-Agent) zusätzlich VM.GuestAgent.Audit (PVE 9) bzw. VM.Monitor (PVE 8)
PVE_URL=https://192.168.10.2:8006
PVE_TOKEN=proxylink@pve!dash=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PVE_INSECURE=true
# Storages für die Statusleiste: Storage-ID oder Pfad aus Datacenter → Storage (kommagetrennt)
PVE_STORAGES=/mnt/share
# Alternativ/zusätzlich direkt in den Container gemountete Pfade: name=/pfad
# LOCAL_DISKS=share=/mnt/share
STATS_SECONDS=15

# --- Telegram-Alarme (optional) ---
# Bot bei @BotFather anlegen, Chat-ID z. B. über @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_CPU=90                    # % (0 = aus)
ALERT_RAM=90                    # % (0 = aus)
ALERT_DISK=90                   # % für Root-Disks + Storages (0 = aus)
ALERT_MINUTES=2                 # so lange muss der Wert über der Grenze liegen
ALERT_HYSTERESIS=5              # Entwarnung erst 5 % unter der Grenze
ALERT_REPEAT_MINUTES=0          # Erinnerung, solange es anhält (0 = nie)
ALERT_NODE_DOWN=true            # Meldung, wenn ein Node offline geht

# --- Docker (optional) ---
# name=url[@host-ip], mehrere mit ";" trennen.
# @host-ip = IP, unter der veröffentlichte Ports des Hosts erreichbar sind (bei tcp:// automatisch)
DOCKER_HOSTS=lokal=unix:///var/run/docker.sock@192.168.20.10;nas=tcp://192.168.20.11:2375
DOCKER_GID=999

# --- Darstellung ---
TITLE=proxylink
LINK_SCHEME=https
REFRESH_SECONDS=60
SHOW_DISABLED=true
SHOW_UNPROXIED=true            # laufende Dienste ohne Zoraxy-Route anzeigen
PROBE_PORTS=80,443,3000,5000,5001,8000,8006,8080,8081,8096,8123,8443,9000,9443
# EDIT_TOKEN=geheim             # wenn gesetzt, braucht Hinzufügen/Löschen diesen Token
CHECK_ORIGINS=true
EXCLUDE=
